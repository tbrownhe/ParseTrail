{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "biome check --write --config-path=./biome.json --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "lint:check": "biome check --config-path=./biome.json --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "test:website": "node --test ../website/tests/*.test.cjs",
    "preview": "vite preview",
    "generate-openapi": "node ./generate-openapi.mjs",
    "generate-client": "npm run generate-openapi && openapi-ts --file ./openapi-ts.config.ts"
  },
  "dependencies": {
    "@chakra-ui/icons": "2.1.1",
    "@chakra-ui/react": "2.8.2",
    "@emotion/react": "11.11.3",
    "@emotion/styled": "11.11.0",
    "@tanstack/react-query": "^5.28.14",
    "@tanstack/react-query-devtools": "^5.28.14",
    "@tanstack/react-router": "1.19.1",
    "framer-motion": "10.16.16",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.13",
    "react-hook-form": "7.49.3",
    "react-icons": "5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@tanstack/router-devtools": "1.19.1",
    "@tanstack/router-vite-plugin": "1.19.0",
    "@types/node": "22.20.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react-swc": "4.3.3",
    "dotenv": "^16.4.5",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
