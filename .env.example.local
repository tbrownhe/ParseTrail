# Copy to .env for the explicit docker-compose.dev.yml stack.
PROJECT_NAME=ParseTrail
STACK_NAME=parsetrail
ENVIRONMENT=local

# Public/runtime URLs. BACKEND_HOST includes the API prefix.
DOMAIN=localhost
BACKEND_HOST=http://localhost:8000/api/v1
FRONTEND_HOST=http://localhost:8080
GITHUB_URL=https://github.com/tbrownhe/ParseTrail
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8080

# Local Traefik is not required, but Compose interpolates these labels.
# Escape each literal $ in an htpasswd hash as $$ for Compose.
TRAEFIK_USER=local
TRAEFIK_HASH=local
SWAGGER_HASH=local
EMAIL=local@example.com
TRAEFIK_ALLOWED_IP_RANGES=0.0.0.0/0,::/0

# Authentication and initial local admin. Replace all placeholders.
SECRET_KEY=replace-with-a-random-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-random-password
SENTRY_DSN=

# Optional SMTP. Password reset/verification is unavailable when SMTP_HOST is empty.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
EMAILS_FROM_NAME=ParseTrail
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587

# Local PostgreSQL. Containers override POSTGRES_SERVER to the service name "db".
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_IMAGE=postgres:12.22@sha256:2f2a8c2a7d10862e7fba2602e304523554f9df8244c632dafe2628ccb398fb5c
POSTGRES_VOLUME_NAME=parsetrail_app-db-data
SUBMISSION_KEYS_VOLUME_NAME=parsetrail_app-keys-data

# Local image names.
DOCKER_IMAGE_BACKEND=parsetrail-backend
DOCKER_IMAGE_FRONTEND=parsetrail-frontend
DOCKER_IMAGE_WEBSITE=parsetrail-website

# 32 random bytes, standard base64 encoded. This is not the release-signing key.
MASTER_KEY=replace-with-a-base64-32-byte-key

# Absolute host directories shared with Docker Desktop.
CLIENTS_DIR=C:\path\to\parsetrail-resources\clients
PLUGINS_DIR=C:\path\to\parsetrail-resources\plugins
STATEMENTS_DIR=C:\path\to\parsetrail-resources\statements

# Optional numeric Linux ownership for newly stored ciphertext. Leave empty on
# Windows/macOS and whenever the container user already owns the bind mount.
STATEMENTS_FILE_OWNER=
STATEMENTS_FILE_GROUP=

# Optional server-statement devtool configuration. These values are not used by
# the application stack itself.
SSH_KEY_PATH=
REMOTE_HOST=
REMOTE_USER=
REMOTE_ENV_PATH=
REMOTE_STATEMENTS_DIR=
SSH_TUNNEL_ENABLE=false
SSH_TUNNEL_LOCAL_PORT=55432
DB_CONTAINER_NAME=parsetrail-db-1
DB_CONTAINER_PORT=5432
