# Copy outside the repository and pass it with --env-file.
ENVIRONMENT=staging
PLUGINS_DIR=C:\path\to\parsetrail-resources\plugins

SSH_TUNNEL_ENABLE=true
SSH_TUNNEL_LOCAL_PORT=55433
DB_CONTAINER_NAME=parsetrail-staging-db-1
DB_CONTAINER_PORT=5432
REMOTE_HOST=silicide
REMOTE_USER=replace-me
SSH_KEY_PATH=~/.ssh/id_rsa
REMOTE_ENV_PATH=/srv/parsetrail-staging/.env
REMOTE_STATEMENTS_DIR=/srv/parsetrail-staging/resources/statements

# These are fetched from REMOTE_ENV_PATH when SSH_TUNNEL_ENABLE=true.
POSTGRES_SERVER=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MASTER_KEY=
STATEMENTS_DIR=
