{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "parser_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,79}$",
      "title": "Parser Id",
      "type": "string"
    },
    "revision": {
      "pattern": "^[1-9][0-9]{0,8}$",
      "title": "Revision",
      "type": "string"
    },
    "suffix": {
      "const": ".pdf",
      "title": "Suffix",
      "type": "string"
    },
    "kind": {
      "const": "statement",
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "const": "printed_account_value_summary_v1",
      "title": "Operation",
      "type": "string"
    },
    "period_format": {
      "const": "Month D, YYYY - Month D, YYYY",
      "title": "Period Format",
      "type": "string"
    },
    "money_format": {
      "const": "usd_or_decimal_2dp_or_dash",
      "title": "Money Format",
      "type": "string"
    },
    "account_format": {
      "const": "NNN-NNNNNN",
      "title": "Account Format",
      "type": "string"
    },
    "account_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Account Label",
      "type": "string"
    },
    "summary_header": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Summary Header",
      "type": "string"
    },
    "opening_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Opening Label",
      "type": "string"
    },
    "closing_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Closing Label",
      "type": "string"
    },
    "row_labels": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Row Labels",
      "type": "array"
    },
    "valuation_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Valuation Label",
      "type": "string"
    },
    "summary_window_lines": {
      "maximum": 20,
      "minimum": 5,
      "title": "Summary Window Lines",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "parser_id",
    "revision",
    "suffix",
    "kind",
    "operation",
    "period_format",
    "money_format",
    "account_format",
    "account_label",
    "summary_header",
    "opening_label",
    "closing_label",
    "row_labels",
    "valuation_label",
    "summary_window_lines"
  ],
  "title": "InvestmentSummaryDefinition",
  "type": "object"
}
