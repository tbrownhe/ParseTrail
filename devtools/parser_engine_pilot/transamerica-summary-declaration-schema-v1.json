{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "parser_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,79}$",
      "title": "Parser Id",
      "type": "string"
    },
    "revision": {
      "pattern": "^[1-9][0-9]{0,8}$",
      "title": "Revision",
      "type": "string"
    },
    "suffix": {
      "const": ".pdf",
      "title": "Suffix",
      "type": "string"
    },
    "kind": {
      "const": "statement",
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "const": "single_column_retirement_summary_v1",
      "title": "Operation",
      "type": "string"
    },
    "period_format": {
      "const": "Month D, YYYY - Month D, YYYY",
      "title": "Period Format",
      "type": "string"
    },
    "money_format": {
      "const": "signed_usd_2dp",
      "title": "Money Format",
      "type": "string"
    },
    "identity_format": {
      "const": "six_digit_plan_prefix",
      "title": "Identity Format",
      "type": "string"
    },
    "plan_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Plan Label",
      "type": "string"
    },
    "opening_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Opening Label",
      "type": "string"
    },
    "closing_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Closing Label",
      "type": "string"
    },
    "row_labels": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 3,
      "title": "Row Labels",
      "type": "array"
    },
    "income_labels": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "title": "Income Labels",
      "type": "array"
    },
    "required_labels": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Required Labels",
      "type": "array"
    },
    "summary_window_lines": {
      "maximum": 30,
      "minimum": 5,
      "title": "Summary Window Lines",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "parser_id",
    "revision",
    "suffix",
    "kind",
    "operation",
    "period_format",
    "money_format",
    "identity_format",
    "plan_label",
    "opening_label",
    "closing_label",
    "row_labels",
    "income_labels",
    "required_labels",
    "summary_window_lines"
  ],
  "title": "RetirementSummaryDefinition",
  "type": "object"
}
