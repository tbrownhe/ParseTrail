{
  "additionalProperties": false,
  "description": "Finite summary-plus-inherited-date operation, without expression fields.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "parser_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,79}$",
      "title": "Parser Id",
      "type": "string"
    },
    "revision": {
      "pattern": "^[1-9][0-9]{0,8}$",
      "title": "Revision",
      "type": "string"
    },
    "suffix": {
      "const": ".pdf",
      "title": "Suffix",
      "type": "string"
    },
    "kind": {
      "const": "statement",
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "const": "summary_inherited_savings_v1",
      "title": "Operation",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "enum": [
          "pdf_lines_v1",
          "summary_equation_v1",
          "inherited_row_date_v1",
          "printed_running_chain_v1"
        ],
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "period_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Period Label",
      "type": "string"
    },
    "period_separator": {
      "maxLength": 20,
      "minLength": 1,
      "title": "Period Separator",
      "type": "string"
    },
    "account_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Account Label",
      "type": "string"
    },
    "summary_heading": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Summary Heading",
      "type": "string"
    },
    "summary_header": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Summary Header",
      "type": "string"
    },
    "activity_end": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Activity End",
      "type": "string"
    },
    "balance_forward_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Balance Forward Label",
      "type": "string"
    },
    "interest_date_override_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Interest Date Override Label",
      "type": "string"
    },
    "period_date_format": {
      "const": "MM/DD/YY",
      "title": "Period Date Format",
      "type": "string"
    },
    "row_date_format": {
      "const": "MM/DD",
      "title": "Row Date Format",
      "type": "string"
    },
    "money_format": {
      "const": "trailing_minus_2dp",
      "title": "Money Format",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "parser_id",
    "revision",
    "suffix",
    "kind",
    "operation",
    "capabilities",
    "period_label",
    "period_separator",
    "account_label",
    "summary_heading",
    "summary_header",
    "activity_end",
    "balance_forward_label",
    "interest_date_override_label",
    "period_date_format",
    "row_date_format",
    "money_format"
  ],
  "title": "SummarySavingsDefinition",
  "type": "object"
}
