{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "parser_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,79}$",
      "title": "Parser Id",
      "type": "string"
    },
    "revision": {
      "pattern": "^[1-9][0-9]{0,8}$",
      "title": "Revision",
      "type": "string"
    },
    "suffix": {
      "const": ".pdf",
      "title": "Suffix",
      "type": "string"
    },
    "kind": {
      "const": "statement",
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "const": "two_account_running_bank_v1",
      "title": "Operation",
      "type": "string"
    },
    "text_channel": {
      "const": "pdf_simple_text_v1",
      "title": "Text Channel",
      "type": "string"
    },
    "annotation_fallback": {
      "const": "first_page_from_to_v1",
      "title": "Annotation Fallback",
      "type": "string"
    },
    "date_format": {
      "const": "MM/DD/YY+MM/DD",
      "title": "Date Format",
      "type": "string"
    },
    "money_format": {
      "const": "usd_2dp_parenthetical_debit",
      "title": "Money Format",
      "type": "string"
    },
    "account_labels": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "title": "Account Labels",
      "type": "array"
    },
    "opening_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Opening Label",
      "type": "string"
    },
    "closing_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Closing Label",
      "type": "string"
    },
    "other_account_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Other Account Label",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "parser_id",
    "revision",
    "suffix",
    "kind",
    "operation",
    "text_channel",
    "annotation_fallback",
    "date_format",
    "money_format",
    "account_labels",
    "opening_label",
    "closing_label",
    "other_account_label"
  ],
  "title": "OccuBankDefinition",
  "type": "object"
}
