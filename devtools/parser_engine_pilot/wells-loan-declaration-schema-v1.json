{
  "$defs": {
    "PDFRouting": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "header": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header"
        },
        "pdf_metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 8,
          "title": "Pdf Metadata",
          "type": "object"
        }
      },
      "required": [
        "body"
      ],
      "title": "PDFRouting",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "routing": {
      "$ref": "#/$defs/PDFRouting"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "parser_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,79}$",
      "title": "Parser Id",
      "type": "string"
    },
    "revision": {
      "pattern": "^[1-9][0-9]{0,8}$",
      "title": "Revision",
      "type": "string"
    },
    "suffix": {
      "const": ".pdf",
      "title": "Suffix",
      "type": "string"
    },
    "kind": {
      "const": "statement",
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "const": "printed_principal_allocations_v1",
      "title": "Operation",
      "type": "string"
    },
    "date_format": {
      "const": "MM/DD/YY",
      "title": "Date Format",
      "type": "string"
    },
    "money_format": {
      "const": "usd_symbol_2dp",
      "title": "Money Format",
      "type": "string"
    },
    "balance_scope": {
      "const": "principal_component",
      "title": "Balance Scope",
      "type": "string"
    },
    "account_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Account Label",
      "type": "string"
    },
    "statement_date_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Statement Date Label",
      "type": "string"
    },
    "opening_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Opening Label",
      "type": "string"
    },
    "closing_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Closing Label",
      "type": "string"
    },
    "interest_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Interest Label",
      "type": "string"
    },
    "principal_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Principal Label",
      "type": "string"
    },
    "max_activity_rows": {
      "maximum": 100,
      "minimum": 1,
      "title": "Max Activity Rows",
      "type": "integer"
    }
  },
  "required": [
    "routing",
    "schema_version",
    "parser_id",
    "revision",
    "suffix",
    "kind",
    "operation",
    "date_format",
    "money_format",
    "balance_scope",
    "account_label",
    "statement_date_label",
    "opening_label",
    "closing_label",
    "interest_label",
    "principal_label",
    "max_activity_rows"
  ],
  "title": "WellsLoanDefinition",
  "type": "object"
}
