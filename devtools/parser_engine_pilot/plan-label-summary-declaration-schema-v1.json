      "title": "Period Format",
      "type": "string"
    },
    "money_format": {
      "const": "signed_usd_2dp",
      "title": "Money Format",
      "type": "string"
    },
    "title": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "printed_header": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Printed Header",
      "type": "string"
    },
    "browser_header": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Browser Header",
      "type": "string"
    },
    "summary_section_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Summary Section Label",
      "type": "string"
    },
    "period_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Period Label",
      "type": "string"
    },
    "opening_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Opening Label",
      "type": "string"
    },
    "closing_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Closing Label",
      "type": "string"
    },
    "row_labels": {
      "items": {
        "type": "string"
