  "required": [
    "schema_version",
    "parser_id",
    "revision",
    "suffix",
    "kind",
    "operation",
    "period_format",
    "money_format",
    "title",
    "printed_header",
    "browser_header",
    "summary_section_label",
    "period_label",
    "opening_label",
    "closing_label",
    "row_labels",
    "summary_window_lines"
