# Example only. Keep the real file outside Git with mode 600.
PROJECT_NAME=ParseTrail
STACK_NAME=parsetrail
ENVIRONMENT=production

DOMAIN=parsetrail.com
BACKEND_HOST=https://api.parsetrail.com/api/v1
FRONTEND_HOST=https://dashboard.parsetrail.com
GITHUB_URL=https://github.com/tbrownhe/ParseTrail
BACKEND_CORS_ORIGINS=https://parsetrail.com,https://www.parsetrail.com

# Escape each literal $ in an htpasswd hash as $$ for Compose interpolation.
TRAEFIK_USER=replace-me
TRAEFIK_HASH=replace-with-escaped-htpasswd-hash
SWAGGER_HASH=replace-with-escaped-htpasswd-hash
EMAIL=operator@example.com
TRAEFIK_ALLOWED_IP_RANGES=0.0.0.0/0,::/0

SECRET_KEY=replace-with-a-random-secret
FIRST_SUPERUSER=operator@example.com
# Bootstrap-only value; changing it does not rotate an existing account password.
FIRST_SUPERUSER_PASSWORD=replace-with-a-random-password
SENTRY_DSN=

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@parsetrail.com
EMAILS_FROM_NAME=ParseTrail
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-password

# Keep PostgreSQL 12 plus its original volume until the guarded dump/restore
# runbook has produced and verified the PostgreSQL 17 target volume.
POSTGRES_IMAGE=postgres:12.22@sha256:2f2a8c2a7d10862e7fba2602e304523554f9df8244c632dafe2628ccb398fb5c
POSTGRES_VOLUME_NAME=parsetrail_app-db-data
SUBMISSION_KEYS_VOLUME_NAME=parsetrail_app-keys-data

# Registry repositories used by release tooling.
DOCKER_IMAGE_BACKEND=registry.example.com/parsetrail/backend
DOCKER_IMAGE_FRONTEND=registry.example.com/parsetrail/frontend
DOCKER_IMAGE_WEBSITE=registry.example.com/parsetrail/website

# Exact digest references are written for a deployment; never use :latest.
BACKEND_IMAGE_REF=
FRONTEND_IMAGE_REF=
WEBSITE_IMAGE_REF=

# Statement-storage master key: 32 random bytes, standard base64 encoded.
# Store separately from ciphertext backups. This is not the offline signing key.
MASTER_KEY=replace-with-a-base64-32-byte-key

# Absolute, access-controlled server bind mounts.
CLIENTS_DIR=/srv/parsetrail/resources/clients
PLUGINS_DIR=/srv/parsetrail/resources/plugins
STATEMENTS_DIR=/srv/parsetrail/resources/statements

# Optional numeric host ownership for newly written ciphertext.
STATEMENTS_FILE_OWNER=
STATEMENTS_FILE_GROUP=
