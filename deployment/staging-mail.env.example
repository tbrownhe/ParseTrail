# Keep the UI on server loopback and reach it through an SSH port forward.
MAILPIT_UI_BIND_ADDRESS=127.0.0.1
MAILPIT_UI_PORT=8025

# This persistent mailbox is separate from all application and production data.
MAILPIT_VOLUME_NAME=parsetrail-staging-mail-data

# Created by the main Compose project. It is internal, has no internet egress,
# and is shared only by the staging backend, Mailpit, and its constrained UI proxy.
STAGING_MAIL_NETWORK_NAME=parsetrail-staging_mail
